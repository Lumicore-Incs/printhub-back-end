{
  "info": {
    "name": "PrintHub - Get Orders",
    "description": "Postman collection for GET /api/order. Set baseUrl and token before sending the request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "page",
      "value": "0"
    },
    {
      "key": "size",
      "value": "10"
    },
    {
      "key": "search",
      "value": ""
    },
    {
      "key": "status",
      "value": ""
    },
    {
      "key": "dateFrom",
      "value": ""
    },
    {
      "key": "dateTo",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Get Orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/order?page={{page}}&size={{size}}&search={{search}}&status={{status}}&dateFrom={{dateFrom}}&dateTo={{dateTo}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "order"
          ],
          "query": [
            {
              "key": "page",
              "value": "{{page}}"
            },
            {
              "key": "size",
              "value": "{{size}}"
            },
            {
              "key": "search",
              "value": "{{search}}",
              "disabled": true
            },
            {
              "key": "status",
              "value": "{{status}}",
              "disabled": true
            },
            {
              "key": "dateFrom",
              "value": "{{dateFrom}}",
              "disabled": true
            },
            {
              "key": "dateTo",
              "value": "{{dateTo}}",
              "disabled": true
            }
          ]
        }
      },
      "response": []
    }
  ]
}
