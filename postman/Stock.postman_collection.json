{
  "info": {
    "name": "PrintHub - Stock API",
    "description": "Stock CRUD, product search, filtering, pagination, and low-stock requests. Each Item has one Stock record. Set baseUrl and token before use.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "stockId",
      "value": "1"
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "page",
      "value": "0"
    },
    {
      "key": "size",
      "value": "10"
    },
    {
      "key": "search",
      "value": ""
    },
    {
      "key": "type",
      "value": ""
    },
    {
      "key": "status",
      "value": ""
    },
    {
      "key": "date",
      "value": ""
    },
    {
      "key": "dateFrom",
      "value": ""
    },
    {
      "key": "dateTo",
      "value": ""
    },
    {
      "key": "threshold",
      "value": "10"
    }
  ],
  "item": [
    {
      "name": "Stock",
      "item": [
        {
          "name": "Save Stock",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.stockId) pm.collectionVariables.set('stockId', data.stockId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"stock-in\",\n  \"quantity\": 28,\n  \"status\": \"ACTIVE\",\n  \"date\": \"2026-10-20\",\n  \"productId\": {{productId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/stock/save"
          },
          "response": []
        },
        {
          "name": "Get Stocks (pagination and filters)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stock?page={{page}}&size={{size}}&search={{search}}&type={{type}}&status={{status}}&stockId={{stockId}}&date={{date}}&dateFrom={{dateFrom}}&dateTo={{dateTo}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stock"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "{{page}}"
                },
                {
                  "key": "size",
                  "value": "{{size}}"
                },
                {
                  "key": "search",
                  "value": "{{search}}",
                  "disabled": true
                },
                {
                  "key": "type",
                  "value": "{{type}}",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "{{status}}",
                  "disabled": true
                },
                {
                  "key": "stockId",
                  "value": "{{stockId}}",
                  "disabled": true
                },
                {
                  "key": "date",
                  "value": "{{date}}",
                  "disabled": true
                },
                {
                  "key": "dateFrom",
                  "value": "{{dateFrom}}",
                  "disabled": true
                },
                {
                  "key": "dateTo",
                  "value": "{{dateTo}}",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Stock by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/stock/{{stockId}}"
          },
          "response": []
        },
        {
          "name": "Update Stock",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"stock-in\",\n  \"quantity\": 15,\n  \"status\": \"ACTIVE\",\n  \"date\": \"2026-10-20\",\n  \"productId\": {{productId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/stock/update/{{stockId}}"
          },
          "response": []
        },
        {
          "name": "Delete Stock",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/stock/delete/{{stockId}}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Low Stock",
      "item": [
        {
          "name": "Get Low Stock",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stock/low-stock?threshold={{threshold}}&page={{page}}&size={{size}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stock",
                "low-stock"
              ],
              "query": [
                {
                  "key": "threshold",
                  "value": "{{threshold}}"
                },
                {
                  "key": "page",
                  "value": "{{page}}"
                },
                {
                  "key": "size",
                  "value": "{{size}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
