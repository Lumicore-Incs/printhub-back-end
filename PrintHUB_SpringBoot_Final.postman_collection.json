			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@printhub.com\",\n    \"password\": \"admin123\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{protocol}}://{{host}}:{{port}}/api/auth/login",
							"protocol": "{{protocol}}",
							"host": [ "{{host}}" ],
							"port": "{{port}}",
							"path": [ "api", "auth", "login" ]
						}
					}
				},
				{
					"name": "Me",
					"request": {
						"method": "GET",
						"header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
						"url": {
							"raw": "{{protocol}}://{{host}}:{{port}}/api/auth/me",
							"protocol": "{{protocol}}",
							"host": [ "{{host}}" ],
							"port": "{{port}}",
							"path": [ "api", "auth", "me" ]
						}
					}
				}
			]
